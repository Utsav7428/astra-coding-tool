# ASTRA backend coordinates — copy to .env and adjust to your Spring Boot app.
# All values below are the built-in defaults, so .env is optional.

VITE_API_BASE_URL=http://localhost:8081
VITE_ASTRA_WS_URL=ws://localhost:8081/ws
VITE_TERMINAL_WS_URL=ws://localhost:8081/ws/terminal

# Health probe used by the status bar indicator
VITE_HEALTH_PATH=/api/index/count

# Per-service mock switches (false = talk to the real backend)
VITE_MOCK_WORKSPACE=false
VITE_MOCK_EDITOR=false
VITE_MOCK_CHAT=false
VITE_MOCK_TERMINAL=true